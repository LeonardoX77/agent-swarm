#!/usr/bin/env python3
"""Read-only validation of the local Agent Fabric runtime prerequisites."""
import argparse
import getpass
import json
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parents[1] / 'lib'))
from host_config import load_config


def preflight(config):
    config = load_config(config)
    diagnostics = []
    if getpass.getuser() != config['expected_user']: diagnostics.append('EXPECTED_USER_MISMATCH')
    for binary in ('ssh', *config['allowed_runtimes']):
        if not shutil.which(binary): diagnostics.append('BINARY_UNAVAILABLE')
    for root in config['workspace_roots'].values():
        path = Path(root)
        if not path.is_dir() or path.is_symlink(): diagnostics.append('WORKSPACE_UNAVAILABLE')
    # The mini requires its already-mounted local root; the macbook requires its local root.
    if config['role'] == 'mac-mini' and not all(str(root).startswith('/Volumes/') for root in config['workspace_roots'].values()): diagnostics.append('ROLE_PREREQUISITE_UNAVAILABLE')
    return sorted(set(diagnostics))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--config', required=True)
    args = parser.parse_args()
    try:
        config = json.loads(Path(args.config).read_text(encoding='utf-8'))
        diagnostics = preflight(config)
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        print(json.dumps({'status': 'failed', 'diagnostic_code': 'INVALID_HOST_CONFIG'}))
        return 2
    print(json.dumps({'status': 'succeeded' if not diagnostics else 'failed', 'diagnostics': diagnostics}, sort_keys=True))
    return 0 if not diagnostics else 1


if __name__ == '__main__': raise SystemExit(main())
