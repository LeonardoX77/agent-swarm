#!/usr/bin/env python3
"""Validate and send one Agent Fabric request through a configured SSH alias."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parents[1] / 'lib'))
import process
from host_config import load_config
from request import validate_request


def dispatch(request, config, target):
    request = validate_request(request)
    config = load_config(config)
    if target not in config['ssh_aliases']:
        raise ValueError('UNCONFIGURED_ALIAS')
    if request['timeout_seconds'] > config['max_timeout_seconds']:
        raise ValueError('TIMEOUT_EXCEEDED')
    completed = process.run(['ssh', '-T', '-o', 'BatchMode=yes', config['ssh_aliases'][target]], input=json.dumps(request, separators=(',', ':')), timeout=request['timeout_seconds'])
    outcome = process.result(completed)
    if outcome['status'] != 'succeeded': return outcome
    try:
        remote = json.loads(completed.stdout)
        if not isinstance(remote, dict) or remote.get('status') not in ('succeeded', 'failed', 'cancelled'):
            raise ValueError
        result = {key: remote[key] for key in ('status', 'diagnostic_code', 'exit_code') if key in remote and (key != 'exit_code' or isinstance(remote[key], int))}
        if remote.get('status') == 'succeeded' and isinstance(remote.get('output'), str):
            result['output'] = process.bounded_output(remote['output'])
        return result
    except (ValueError, TypeError, json.JSONDecodeError):
        return {'status': 'failed', 'diagnostic_code': 'INVALID_REMOTE_RESULT'}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--config', required=True)
    parser.add_argument('--target', required=True, choices=('macbook', 'mac-mini'))
    parser.add_argument('--request')
    args = parser.parse_args()
    try:
        raw = args.request if args.request is not None else sys.stdin.read()
        request = json.loads(raw)
        config = json.loads(Path(args.config).read_text(encoding='utf-8'))
        print(json.dumps(dispatch(request, config, args.target), sort_keys=True))
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        print(json.dumps({'status': 'failed', 'diagnostic_code': 'INVALID_INPUT'}))
        return 2
    return 0


if __name__ == '__main__': raise SystemExit(main())
