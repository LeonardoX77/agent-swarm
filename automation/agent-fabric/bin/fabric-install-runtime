#!/usr/bin/env python3
"""Non-privileged local Agent Fabric runtime installer."""
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).parents[1]
sys.path.insert(0, str(ROOT / 'lib'))
import install_runtime


def main():
    parser = argparse.ArgumentParser()
    actions = parser.add_mutually_exclusive_group(required=True)
    actions.add_argument('--plan', action='store_true')
    actions.add_argument('--apply', action='store_true')
    actions.add_argument('--revert', action='store_true')
    parser.add_argument('--role', choices=sorted(install_runtime.HOSTS))
    parser.add_argument('--peer-public-key', type=Path)
    parser.add_argument('--home', type=Path, default=Path.home())
    args = parser.parse_args()
    try:
        if args.revert:
            if args.role or args.peer_public_key:
                parser.error('--revert does not accept --role or --peer-public-key')
            result = install_runtime.revert(args.home)
        else:
            if not args.role or not args.peer_public_key:
                parser.error('--plan and --apply require --role and --peer-public-key')
            operation = install_runtime.plan if args.plan else install_runtime.apply
            result = operation(ROOT, args.home, args.role, args.peer_public_key)
    except ValueError as error:
        parser.error(str(error))
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
