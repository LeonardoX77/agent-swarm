#!/usr/bin/env python3
"""Record one sanitized local activity event without coordinating writers."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parents[1] / 'lib'))
from records import activity_event, write_event


parser = argparse.ArgumentParser(add_help=False)
parser.add_argument('--record', required=True)
args, unknown = parser.parse_known_args()

if unknown:
    print('INVALID_ACTIVITY_EVENT')
    raise SystemExit(2)

try:
    event = activity_event(json.load(sys.stdin))
except (json.JSONDecodeError, ValueError, TypeError):
    print('INVALID_ACTIVITY_EVENT')
    raise SystemExit(2)

try:
    write_event(args.record, event)
except ValueError:
    print('UNSAFE_RECORD_DESTINATION')
    raise SystemExit(2)
except OSError:
    print('ACTIVITY_RECORD_WRITE_FAILED')
    raise SystemExit(1)

print('ACTIVITY_RECORDED')
