#!/usr/bin/env python3
"""Forced-command local runner; it never mounts, configures SSH, or uses sudo."""
import argparse
import json
import os
import pwd
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parents[1] / 'lib'))
import environment
import process
from host_config import load_config
from records import fabric_activity_event, write_event
from request import validate_request


def effective_user():
    """Return the account owning the process's effective user ID."""
    return pwd.getpwuid(os.geteuid()).pw_name


def destination(request, config):
    root_text = config['workspace_roots'].get(request['workspace'])
    if not root_text: raise ValueError('WORKSPACE_UNAVAILABLE')
    root = Path(root_text)
    if not root.exists() or root.is_symlink(): raise ValueError('WORKSPACE_UNAVAILABLE')
    try: root = root.resolve(strict=True)
    except (OSError, RuntimeError): raise ValueError('WORKSPACE_UNAVAILABLE') from None
    candidate = root
    if request['relative_path'] != '.':
        for part in request['relative_path'].split('/'):
            candidate = candidate / part
            if candidate.is_symlink(): raise ValueError('PATH_AMBIGUOUS')
    if not candidate.exists(): raise ValueError('WORKSPACE_UNAVAILABLE')
    try: resolved = candidate.resolve(strict=True)
    except (OSError, RuntimeError): raise ValueError('PATH_AMBIGUOUS') from None
    if resolved != root and root not in resolved.parents: raise ValueError('PATH_ESCAPE')
    return resolved


def _record(config, request, status, duration_seconds, diagnostic_code):
    record = config.get('activity_record')
    if not record:
        return False
    try:
        write_event(record, fabric_activity_event(request, status, config['role'], duration_seconds, diagnostic_code))
    except (OSError, ValueError):
        return True
    return False


def run_task(request, config):
    if os.environ.get('SSH_ORIGINAL_COMMAND'):
        raise ValueError('UNEXPECTED_SSH_COMMAND')
    request = validate_request(request)
    config = load_config(config)
    if effective_user() != config['expected_user']:
        raise ValueError('UNEXPECTED_USER')
    if request['timeout_seconds'] > config['max_timeout_seconds']:
        raise ValueError('TIMEOUT_EXCEEDED')
    cwd = destination(request, config)
    started_at = time.monotonic()
    record_failed = _record(config, request, 'started', 0, 'STARTED')
    name = 'fabric-' + request['request_id']
    child_env = environment.child_environment(os.environ)
    completed = process.run(['pi', '-p', '--approve', '--name', name, '--', request['prompt']], cwd=str(cwd), timeout=request['timeout_seconds'], env=child_env)
    outcome = process.result(completed)
    duration_seconds = time.monotonic() - started_at
    record_failed = _record(config, request, outcome['status'], duration_seconds, outcome.get('diagnostic_code', 'NONE')) or record_failed
    if record_failed:
        outcome['warnings'] = ['ACTIVITY_RECORD_FAILED']
    return outcome


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--config', required=True)
    args = parser.parse_args()
    try:
        config = json.loads(Path(args.config).read_text(encoding='utf-8'))
        request = json.load(sys.stdin)
        print(json.dumps(run_task(request, config), sort_keys=True))
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        print(json.dumps({'status': 'failed', 'diagnostic_code': 'INVALID_INPUT'}))
        return 2
    return 0


if __name__ == '__main__': raise SystemExit(main())
