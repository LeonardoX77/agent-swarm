#!/usr/bin/env python3
"""Connect SSH's ProxyCommand to the first reachable TCP candidate."""
import argparse
import os
import select
import socket
import sys


def parser():
    value = argparse.ArgumentParser(prog="swarm-ssh-connect")
    value.add_argument("--port", required=True, type=int)
    value.add_argument("--timeout", type=float, default=3)
    value.add_argument("candidates", nargs="+")
    return value


def relay(connection):
    """Relay raw file descriptors so interactive SSH packets are never buffered."""
    stdin = sys.stdin.fileno()
    stdout = sys.stdout.fileno()
    connection.settimeout(None)
    reads = [stdin, connection]
    while reads:
        ready, _, _ = select.select(reads, [], [])
        if stdin in ready:
            data = os.read(stdin, 65536)
            if data:
                try:
                    connection.sendall(data)
                except OSError:
                    return
            else:
                reads.remove(stdin)
                try:
                    connection.shutdown(socket.SHUT_WR)
                except OSError:
                    pass
        if connection in ready:
            try:
                data = connection.recv(65536)
            except OSError:
                return
            if not data:
                return
            os.write(stdout, data)


def main(argv=None):
    args = parser().parse_args(argv)
    if not 1 <= args.port <= 65535 or args.timeout <= 0:
        parser().error("--port must be 1-65535 and --timeout must be positive")
    for candidate in args.candidates:
        if candidate.startswith("-"):
            print("swarm-ssh-connect: invalid candidate: " + candidate, file=sys.stderr)
            return 255
    failures = []
    for candidate in args.candidates:
        try:
            connection = socket.create_connection((candidate, args.port), timeout=args.timeout)
        except OSError as error:
            failures.append("%s: %s" % (candidate, error))
            continue
        try:
            relay(connection)
        finally:
            connection.close()
        return 0
    print("swarm-ssh-connect: no candidate reachable: " + "; ".join(failures), file=sys.stderr)
    return 255


if __name__ == "__main__":
    raise SystemExit(main())
