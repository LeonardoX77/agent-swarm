#!/usr/bin/env python3
"""Mount SMB using macOS Keychain or Linux user-mountable CIFS fstab entries.

Linux: use fstab-line for the exact /etc/fstab entry and credentials template.
A human must create the mount directory, edit fstab as root, and create the
credentials file with mode 0600. This tool never uses sudo or handles passwords.
--persistent uses a 300-second user timer, degrading with a warning if unavailable.
"""

import argparse
import getpass
import json
import os
import plistlib
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOST_RE = re.compile(r"^[A-Za-z0-9.-]+$")
NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")


class ToolError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise ToolError("invalid_arguments", message)


def agent_label(host, share):
    """Return a deterministic, LaunchAgent-safe label."""
    clean = lambda value: re.sub(r"[^A-Za-z0-9]+", "-", value).strip("-")
    return "com.mac-agent-swarm.smb.%s.%s" % (clean(host), clean(share))


def source_matches(source, host, share, user):
    match = re.match(r"^//([^@/]+)@([^/]+)/([^/]+)$", source)
    if not match:
        return False
    actual_user, actual_host, actual_share = match.groups()
    return actual_user == user and actual_host.lower() == host.lower() and actual_share == share


def matching_mount(mount_output, host, share, user):
    """Find exactly the matching smb source in /sbin/mount output."""
    for line in mount_output.splitlines():
        match = re.match(r"^(//\S+) on (.+?) \(", line)
        if match and source_matches(match.group(1), host, share, user):
            return match.group(2)
    return None


class SMBMount:
    def __init__(self, runner=None, home=None, uid=None, sleep=None, env=None):
        self.runner = runner or self._subprocess_runner
        self.home = Path(home) if home is not None else Path.home()
        self.uid = os.getuid() if uid is None else uid
        self.sleep = sleep or time.sleep
        self.env = os.environ if env is None else env

    @staticmethod
    def _subprocess_runner(argv, timeout):
        return subprocess.run(argv, shell=False, text=True, capture_output=True, timeout=timeout)

    def _run(self, argv, timeout=30):
        try:
            return self.runner(argv, timeout=timeout)
        except subprocess.TimeoutExpired:
            raise ToolError("command_timeout", "Command timed out: %s" % argv[0])
        except OSError as exc:
            raise ToolError("command_error", "Could not run %s: %s" % (argv[0], exc))

    def _mount_point(self, host, share, user):
        result = self._run(["/sbin/mount"])
        if result.returncode != 0:
            raise ToolError("mount_table_error", "Could not read the mount table")
        return matching_mount(result.stdout, host, share, user)

    def status(self, host, share, user):
        point = self._mount_point(host, share, user)
        if point is None:
            return {"ok": True, "mounted": False}
        return {"ok": True, "mounted": True, "mount_point": point}

    def plist_path(self, host, share):
        return self.home / "Library/LaunchAgents" / (agent_label(host, share) + ".plist")

    def _local_script_path(self):
        return self.home / ".local/agent-swarm/bin/swarm-smb-mount"

    def _install_persistent(self, host, share, user):
        local_script = self._local_script_path()
        local_script.parent.mkdir(parents=True, exist_ok=True)
        self._atomic_copy(Path(__file__), local_script, 0o755)
        logs = self.home / "Library/Logs/mac-agent-swarm"
        logs.mkdir(parents=True, exist_ok=True)
        label = agent_label(host, share)
        plist_path = self.plist_path(host, share)
        plist_path.parent.mkdir(parents=True, exist_ok=True)
        data = {
            "Label": label,
            "ProgramArguments": ["/usr/bin/python3", str(local_script), "mount", "--host", host,
                                 "--share", share, "--user", user],
            "RunAtLoad": True,
            "StartInterval": 300,
            "StandardOutPath": str(logs / (label + ".out.log")),
            "StandardErrorPath": str(logs / (label + ".err.log")),
        }
        self._atomic_write(plist_path, plistlib.dumps(data), 0o644)
        target = "gui/%s/%s" % (self.uid, label)
        # A non-loaded agent is normal on first installation.
        self._run(["/bin/launchctl", "bootout", target])
        result = self._run(["/bin/launchctl", "bootstrap", "gui/%s" % self.uid, str(plist_path)])
        if result.returncode != 0:
            raise ToolError("launchagent_error", "Could not bootstrap LaunchAgent: %s" % result.stderr.strip())
        return label, plist_path

    @staticmethod
    def _atomic_write(path, data, mode):
        fd, temporary = tempfile.mkstemp(prefix=".%s." % path.name, dir=str(path.parent))
        try:
            with os.fdopen(fd, "wb") as output:
                output.write(data)
                output.flush()
                os.fsync(output.fileno())
            os.chmod(temporary, mode)
            os.replace(temporary, str(path))
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)

    @staticmethod
    def _atomic_copy(source, destination, mode):
        fd, temporary = tempfile.mkstemp(prefix=".%s." % destination.name, dir=str(destination.parent))
        try:
            with os.fdopen(fd, "wb") as output:
                with source.open("rb") as input_file:
                    shutil.copyfileobj(input_file, output)
                output.flush()
                os.fsync(output.fileno())
            os.chmod(temporary, mode)
            os.replace(temporary, str(destination))
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)

    @staticmethod
    def _is_no_gui_error(result):
        text = (result.stdout + " " + result.stderr).lower()
        return any(term in text for term in ("no gui", "no user interaction", "gui session", "connection is invalid", "not allowed to send apple events"))

    def _loaded_agent(self, host, share):
        result = self._run(["/bin/launchctl", "print", "gui/%s/%s" % (self.uid, agent_label(host, share))])
        return result.returncode == 0

    def _wait_for_mount(self, host, share, user, wait):
        for attempt in range(wait + 1):
            point = self._mount_point(host, share, user)
            if point is not None:
                return point
            if attempt < wait:
                self.sleep(1)
        raise ToolError("mount_timeout", "Share did not appear in the mount table within %s seconds" % wait)

    def mount(self, host, share, user, persistent, wait):
        persistent_details = None
        if persistent:
            # Install before mounting so an SSH invocation can immediately use it.
            persistent_details = self._install_persistent(host, share, user)
        point = self._mount_point(host, share, user)
        via = "already_mounted"
        if point is None:
            result = self._run(["/usr/bin/osascript", "-e", 'mount volume "smb://%s@%s/%s"' % (user, host, share)], timeout=45)
            can_kickstart = self._is_no_gui_error(result) or bool(self.env.get("SSH_CONNECTION"))
            if result.returncode == 0:
                via = "osascript"
                point = self._wait_for_mount(host, share, user, wait)
            elif can_kickstart and self._loaded_agent(host, share):
                kickstart = self._run(["/bin/launchctl", "kickstart", "-k", "gui/%s/%s" % (self.uid, agent_label(host, share))])
                if kickstart.returncode != 0:
                    raise ToolError("launchagent_error", "Could not kickstart the persistent LaunchAgent")
                via = "launchagent"
                point = self._wait_for_mount(host, share, user, wait)
            elif self._is_no_gui_error(result):
                raise ToolError("gui_session_required", "Run this in the macOS GUI session or install --persistent first")
            else:
                raise ToolError("mount_failed", "osascript could not mount the SMB share: %s" % result.stderr.strip())
        response = {"ok": True, "mounted": True, "mount_point": point, "via": via}
        expected = "/Volumes/%s" % share
        if point != expected:
            response["unexpected_mount_point"] = point
        if persistent_details is not None:
            label, plist_path = persistent_details
            response["label"] = label
            response["plist"] = str(plist_path)
        return response

    def unmount(self, host, share, user, remove_persistent):
        point = self._mount_point(host, share, user)
        response = {"ok": True, "mounted": point is not None, "unmounted": False}
        if point is not None:
            result = self._run(["/usr/sbin/diskutil", "unmount", point], timeout=60)
            if result.returncode != 0:
                raise ToolError("unmount_failed", "diskutil could not unmount %s: %s" % (point, result.stderr.strip()))
            response["unmounted"] = True
        if remove_persistent:
            label = agent_label(host, share)
            self._run(["/bin/launchctl", "bootout", "gui/%s/%s" % (self.uid, label)])
            plist_path = self.plist_path(host, share)
            if plist_path.exists():
                plist_path.unlink()
            response["persistent_removed"] = True
        return response


class LinuxSMBMount(SMBMount):
    """Unprivileged Linux backend; fstab and credentials remain human-owned."""
    @staticmethod
    def _source_matches(source, host, share):
        return source.lower().startswith("//" + host.lower() + "/") and source.split("/", 3)[-1] == share

    @staticmethod
    def _unescape(value):
        return re.sub(r"\\(?:x([0-9a-fA-F]{2})|([0-7]{3}))", lambda m: chr(int(m[1], 16) if m[1] else int(m[2], 8)), value)

    def _mount_point(self, host, share, user):
        result = self._run(["findmnt", "-rn", "-t", "cifs", "-o", "SOURCE,TARGET"])
        # findmnt exits 1 when there are no matching filesystems.
        if result.returncode not in (0, 1):
            raise ToolError("mount_table_error", "Could not read the CIFS mount table")
        for line in result.stdout.splitlines():
            fields = line.split()
            if len(fields) == 2 and self._source_matches(self._unescape(fields[0]), host, share):
                return self._unescape(fields[1])
        return None

    def fstab_line(self, host, share, user):
        credentials = str(self.home.resolve() / ".config/agent-swarm/smb-credentials")
        escaped = credentials.replace("\\", "\\134").replace(" ", "\\040").replace("\t", "\\011")
        return {"ok": True, "fstab_line": "//%s/%s /mnt/%s cifs credentials=%s,uid=%s,gid=%s,vers=3.0,noauto,user,_netdev 0 0" % (host, share, share, escaped, self.uid, os.getgid()),
                "credentials_file": credentials, "credentials_mode": "0600",
                "credentials_template": "username=%s\npassword=<your SMB password>\n" % user,
                "message": "As root, add fstab_line to /etc/fstab and create /mnt/%s. Create credentials_file yourself with mode 0600; the tool never writes it." % share}

    def _require_fstab(self, host, share, user):
        result = self._run(["findmnt", "--fstab", "-rn", "-t", "cifs", "-o", "SOURCE,TARGET,OPTIONS"])
        for line in result.stdout.splitlines() if result.returncode == 0 else ():
            fields = line.split()
            if (len(fields) == 3 and self._source_matches(self._unescape(fields[0]), host, share)
                    and self._unescape(fields[1]) == "/mnt/" + share
                    and {"user", "users"}.intersection(fields[2].split(","))):
                return
        raise ToolError("fstab_entry_required", "A user-mountable CIFS fstab entry is required. Run swarm-smb-mount fstab-line --host %s --share %s --user %s; as root add its exact line to /etc/fstab and create /mnt/%s, then create the credentials file yourself with mode 0600." % (host, share, user, share))

    def _unit_paths(self, host, share):
        base = self.home / ".config/systemd/user" / agent_label(host, share)
        return base.with_name(base.name + ".service"), base.with_name(base.name + ".timer")

    @staticmethod
    def _unit_quote(value, executable=False):
        value = str(value).replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%")
        if not executable: value = value.replace("$", "$$")
        return '"' + value + '"'

    @staticmethod
    def _unit_log(path):
        # StandardOutput/Error paths are not ExecStart words: quotes are literal.
        value = str(path)
        return "append:" + value if re.fullmatch(r"/[A-Za-z0-9/._-]+", value) else "journal"

    def _install_persistent(self, host, share, user):
        try:
            result = self._run(["systemctl", "--user", "show-environment"])
            if result.returncode:
                return {"persistent": False, "warning": "systemctl --user is unavailable; mount persistence was not enabled"}
        except ToolError:
            return {"persistent": False, "warning": "systemctl --user is unavailable; mount persistence was not enabled"}
        local = self._local_script_path()
        local.parent.mkdir(parents=True, exist_ok=True)
        self._atomic_copy(Path(__file__), local, 0o755)
        service, timer = self._unit_paths(host, share)
        service.parent.mkdir(parents=True, exist_ok=True)
        logs = self.home / ".local/state/agent-swarm/logs"
        logs.mkdir(parents=True, exist_ok=True)
        command = self._unit_quote(local, executable=True) + " " + " ".join(
            self._unit_quote(arg) if not re.fullmatch(r"[A-Za-z0-9._-]+", arg) else arg
            for arg in ("mount", "--host", host, "--share", share, "--user", user))
        data = ("[Unit]\nDescription=Agent Swarm SMB mount\n[Service]\nType=oneshot\nExecStart=%s\n"
                "StandardOutput=%s\nStandardError=%s\n" % (command, self._unit_log(logs / (service.stem + ".out.log")), self._unit_log(logs / (service.stem + ".err.log"))))
        self._atomic_write(service, data.encode(), 0o644)
        self._atomic_write(timer, ("[Unit]\nDescription=Agent Swarm SMB mount timer\n[Timer]\nOnBootSec=1s\nOnUnitActiveSec=300s\n[Install]\nWantedBy=timers.target\n").encode(), 0o644)
        for argv in (["systemctl", "--user", "daemon-reload"], ["systemctl", "--user", "enable", "--now", timer.name]):
            try:
                if self._run(argv).returncode == 0: continue
            except ToolError:
                pass
            return {"persistent": False, "warning": "systemctl --user could not enable mount persistence"}
        return {"persistent": True, "label": service.stem, "service": str(service), "timer": str(timer)}

    def mount(self, host, share, user, persistent, wait):
        point = self._mount_point(host, share, user)
        via = "already_mounted"
        if point is None:
            self._require_fstab(host, share, user)
            result = self._run(["mount", "/mnt/" + share], timeout=45)
            if result.returncode:
                raise ToolError("mount_failed", "mount could not mount /mnt/%s: %s" % (share, result.stderr.strip()))
            point = self._wait_for_mount(host, share, user, wait)
            via = "mount"
        response = {"ok": True, "mounted": True, "mount_point": point, "via": via}
        if point != "/mnt/" + share: response["unexpected_mount_point"] = point
        if persistent: response.update(self._install_persistent(host, share, user))
        return response

    def unmount(self, host, share, user, remove_persistent):
        point = self._mount_point(host, share, user)
        response = {"ok": True, "mounted": point is not None, "unmounted": False}
        if point is not None:
            result = self._run(["umount", point], timeout=60)
            if result.returncode:
                raise ToolError("unmount_failed", "umount could not unmount %s: %s" % (point, result.stderr.strip()))
            response["unmounted"] = True
        if remove_persistent:
            service, timer = self._unit_paths(host, share)
            try:
                result = self._run(["systemctl", "--user", "disable", "--now", timer.name])
                if result.returncode: response["warning"] = "systemctl --user could not disable the mount timer"
            except ToolError:
                response["warning"] = "systemctl --user is unavailable; could not disable the mount timer"
            if "warning" in response:
                response["persistent_removed"] = not any(path.exists() for path in (service, timer))
                return response
            for path in (service, timer):
                if path.exists(): path.unlink()
            try: self._run(["systemctl", "--user", "daemon-reload"])
            except ToolError: pass
            response["persistent_removed"] = True
        return response


def build_parser():
    parser = Parser(prog="swarm-smb-mount", description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("status", "mount", "unmount", "fstab-line"):
        command = commands.add_parser(name)
        command.add_argument("--host", required=True)
        command.add_argument("--share", required=True)
        command.add_argument("--user", default=getpass.getuser())
        if name == "mount":
            command.add_argument("--persistent", action="store_true")
            command.add_argument("--wait", type=int, default=30)
        if name == "unmount":
            command.add_argument("--remove-persistent", action="store_true")
    return parser


def validate(args):
    if not HOST_RE.fullmatch(args.host) or not NAME_RE.fullmatch(args.share) or not NAME_RE.fullmatch(args.user):
        raise ToolError("invalid_arguments", "host, share, or user has invalid characters")
    if getattr(args, "wait", 1) < 1 or getattr(args, "wait", 1) > 300:
        raise ToolError("invalid_arguments", "--wait must be between 1 and 300")


def run(argv=None, runner=None, home=None, uid=None):
    try:
        args = build_parser().parse_args(argv)
        if sys.platform not in ("darwin", "linux"):
            raise ToolError("unsupported_platform", "swarm-smb-mount only supports macOS or Linux")
        validate(args)
        tool = (LinuxSMBMount if sys.platform == "linux" else SMBMount)(runner, home, uid)
        if args.command == "fstab-line":
            if sys.platform != "linux":
                raise ToolError("invalid_arguments", "fstab-line is only supported on Linux")
            response = tool.fstab_line(args.host, args.share, args.user)
        elif args.command == "status":
            response = tool.status(args.host, args.share, args.user)
        elif args.command == "mount":
            response = tool.mount(args.host, args.share, args.user, args.persistent, args.wait)
        else:
            response = tool.unmount(args.host, args.share, args.user, args.remove_persistent)
        return 0, response
    except ToolError as exc:
        return 2, {"ok": False, "error": exc.code, "message": exc.message}
    except Exception:
        return 2, {"ok": False, "error": "unexpected_error", "message": "Unexpected internal error"}


def main():
    code, response = run()
    print(json.dumps(response, sort_keys=True))
    return code


if __name__ == "__main__":
    sys.exit(main())
