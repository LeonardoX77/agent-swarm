#!/usr/bin/env python3
"""Set up a registered Agent Swarm host (macOS or Linux/WSL) in one resumable process.

Linux/WSL uses a human-configured, user-mountable CIFS fstab entry and user systemd
services for persistent mounts and daily updates. Credentials are created by the human.
"""
import argparse
import sys
from pathlib import Path

if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(line_buffering=True)

sys.path.insert(0, str(Path(__file__).parents[1] / 'lib'))
from swarm_setup import Setup


def parser():
    value = argparse.ArgumentParser(prog='swarm-setup', description=__doc__)
    commands = value.add_subparsers(dest='command', required=True)
    add = commands.add_parser('add-host', help='configure a macOS or Linux/WSL host through SSH')
    add.add_argument('--name', required=True); add.add_argument('--address', required=True); add.add_argument('--user', required=True)
    add.add_argument('--role', choices=('hub', 'spoke'), default='spoke'); add.add_argument('--host-fingerprint'); add.add_argument('--origin-user')
    update = add.add_mutually_exclusive_group(); update.add_argument('--auto-update', dest='auto_update', action='store_true', default=True); update.add_argument('--no-auto-update', dest='auto_update', action='store_false')
    add.add_argument('--update-time', default='04:30'); add.add_argument('--install-missing', action='store_true', help='install herdr with Homebrew on macOS or download https://herdr.dev/install.sh with curl and run with sh on Linux; install missing gentle-pi with pi (dry-run only reports planned installs)'); add.add_argument('--skip-live', action='store_true'); add.add_argument('--dry-run', action='store_true'); add.add_argument('--no-wait', action='store_true'); add.add_argument('--wait-timeout', type=int, default=30); add.add_argument('--verbose', action='store_true'); add.add_argument('--registry')
    status = commands.add_parser('status', help='show saved setup state'); status.add_argument('--name', required=True)
    return value


def main(argv=None):
    args = parser().parse_args(argv)
    if args.command == 'status':
        path = Path.home() / '.local/state/agent-swarm/setup' / (args.name + '.json')
        if path.exists(): print(path.read_text(encoding='utf-8'), end='')
        else: print('No saved setup state for ' + args.name)
        return 0
    if not 0 <= args.wait_timeout <= 1440 or len(args.update_time) != 5 or args.update_time[2] != ':':
        print('INVALID_INPUT', file=sys.stderr); return 2
    setup = Setup(args.name, args.address, args.user, role=args.role, host_fingerprint=args.host_fingerprint,
                  origin_user=args.origin_user, auto_update=args.auto_update, update_time=args.update_time, install_missing=args.install_missing,
                  skip_live=args.skip_live, dry_run=args.dry_run, no_wait=args.no_wait,
                  wait_timeout=args.wait_timeout, verbose=args.verbose, registry_path=args.registry)
    return setup.run()


if __name__ == '__main__': raise SystemExit(main())
