# Copy into jarvis's local ~/.ssh/config and replace only the placeholders.
# HostName: choose the MacBook's reachable LAN address or its Tailscale name/IP.
Host agent-fabric-macbook
    HostName <MACBOOK_LAN_OR_TAILSCALE_ENDPOINT>
    User leo
    IdentityFile ~/.ssh/agent-fabric-mac-mini-to-macbook
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    ForwardAgent no
    ForwardX11 no
    RequestTTY no
